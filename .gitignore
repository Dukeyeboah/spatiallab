node_modules
.next
out
next-env.d.ts
*.tsbuildinfo
.DS_Store

# Raw scanner recordings are large and private; keep them out of git.
*.las
*.laz
*.xbin

# Generated reconstruction data (XGRIDS index, extracted images, ...). The XGRIDS
# scripts write next to the recording by default; this covers a copy inside the repo.
/reconstruction/

# Generated Gaussian scenes. *.ply is deliberately not ignored so a tiny test
# fixture can be committed; real scenes live in spatial-data/ (ignored below).
*.splat
*.ksplat

# Converted point clouds (regenerate with scripts/convert_las.py).
public/data/*.bin
# Dataset previews (e.g. basel-house): binaries and scanner poses stay local, metadata JSON is tracked.
public/datasets/**/*.bin
public/datasets/**/poses.csv

# Local dataset store written by the backend (uploads + converted data).
spatial-data/

# Local authoring sources (Blender files, raw scans) — keep out of git.
/source-data/

# XGRIDS LCC sample models (large SOG/LCC2 packages; extract locally for Lab LCC-WEB-01).
public/labs/lcc-samples/

# Client property LCC packages (LAB PROD-01+). Keep config JSON in git; models stay local / R2.
public/labs/properties/**/ground/
public/labs/properties/**/first/
public/labs/properties/**/floors/
public/labs/properties/**/*.bin
public/labs/properties/**/*.lcc
public/labs/properties/**/*.lcc2
public/labs/properties/**/*.lci
public/labs/properties/**/*.lcp
public/labs/properties/**/data/
public/labs/properties/**/assets/
# Large construction dressing GLBs for outdoor labs (keep local; copy from Downloads).
public/labs/properties/**/props/Sign.glb
public/labs/properties/**/props/traffic_barricade.glb
# Allow tracked README / experience JSON / small previews under properties/
!public/labs/properties/**/README.md
!public/labs/properties/**/*.experience.json
!public/labs/properties/**/previews/

# Python backend environment.
backend/.venv/
__pycache__/
