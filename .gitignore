node_modules
.next
out
next-env.d.ts
*.tsbuildinfo
.DS_Store

# Raw scanner recordings are large and private; keep them out of git.
*.las
*.laz
*.xbin

# Generated reconstruction data (XGRIDS index, extracted images, ...). The XGRIDS
# scripts write next to the recording by default; this covers a copy inside the repo.
/reconstruction/

# Generated Gaussian scenes. *.ply is deliberately not ignored so a tiny test
# fixture can be committed; real scenes live in spatial-data/ (ignored below).
*.splat
*.ksplat

# Converted point clouds (regenerate with scripts/convert_las.py).
public/data/*.bin
# Dataset previews (e.g. basel-house): binaries and scanner poses stay local, metadata JSON is tracked.
public/datasets/**/*.bin
public/datasets/**/poses.csv

# Local dataset store written by the backend (uploads + converted data).
spatial-data/

# Python backend environment.
backend/.venv/
__pycache__/
