# Frontend → local FastAPI (Lab 7A+). Leave unset for localhost default.
# NEXT_PUBLIC_SPATIAL_API_URL=http://127.0.0.1:8000

# Optional CDN / blob base for LCC sample packages (no trailing slash).
# Required for a working Vercel Experiences deploy — samples are gitignored and too large for git.
# Example after uploading public/labs/lcc-samples/ to R2 or S3 with the same folder layout:
# NEXT_PUBLIC_LCC_ASSET_BASE=https://your-bucket.example.com
